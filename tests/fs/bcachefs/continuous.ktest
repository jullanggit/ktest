#!/usr/bin/env bash

. $(dirname $(readlink -e ${BASH_SOURCE[0]}))/bcachefs-test-libs.sh

require-make continuous

config-scratch-devs 4G
config-scratch-devs 2G
config-scratch-devs 1G

test_basic_loop()
{
    local active_dev=${ktest_scratch_dev[0]}
    local args=()
    local dev

    set_watchdog 60

    run_quiet "" bcachefs format -f "$active_dev"
    mount -t bcachefs "$active_dev" /mnt

    for dev in "${ktest_scratch_dev[@]}"; do
	args+=(--device "$dev")
    done

    continuous-bcachefs-test				\
	"${args[@]}"					\
	--log "$ktest_out/continuous-basic.log"		\
	--mountpoint /mnt

    umount /mnt

    bcachefs fsck -ny "$active_dev"

    mount -t bcachefs "$active_dev" /mnt
    umount /mnt

    bcachefs_test_end_checks "$active_dev"
}

main "$@"
