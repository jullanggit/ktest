#!/usr/bin/env bash

. $(dirname $(readlink -e ${BASH_SOURCE[0]}))/bcachefs-test-libs.sh

require-make continuous

config-scratch-devs 4G
config-scratch-devs 2G
config-scratch-devs 1G

test_basic_loop()
{
    local args=()
    local dev
    local log="$ktest_out/continuous-basic.log"

    set_watchdog 180

    for dev in "${ktest_scratch_dev[@]}"; do
	args+=(--device "$dev")
    done

    if ! continuous-bcachefs-test				\
	"${args[@]}"					\
	--log "$log"					\
	--mountpoint /mnt				\
	--operations 50; then
	echo ":: continuous harness log"
	cat "$log"
	return 1
    fi
}

test_wait() {
    sleep 1d
}

main "$@"
